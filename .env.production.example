# =============================================================
# NicheHive — production environment
# Copy to `.env` on the deployment host: cp .env.production.example .env
# Never commit the populated `.env` — it contains secrets.
# =============================================================

# ---------- App ----------
# Public origin of the web frontend. Used by the backend for redirects
# (after Google OAuth) and CORS. No trailing slash.
FRONTEND_URL=https://nichehive.org

# Public base URL the browser uses to call the backend. Bundled into the
# Next.js build at image-build time, so changing it requires `make rebuild`.
NEXT_PUBLIC_API_URL=https://api.nichehive.org/api/v1

# ---------- Postgres (compose-managed instance) ----------
# Used by the `postgres` service AND by `api` + `migrate` via DATABASE_URL.
# Use strong, unique credentials in prod. Rotate if leaked.
POSTGRES_USER=nichehive
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
POSTGRES_DB=nichehive

# If you use a managed Postgres (Neon, RDS, Supabase) instead of the compose
# service, drop the `postgres` and `migrate` services from compose and set
# DATABASE_URL directly in the api environment via your secrets manager:
#   DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ---------- Google OAuth ----------
# Create at https://console.cloud.google.com → Credentials → OAuth client (Web).
# Authorized redirect URI in Google Console MUST exactly match GOOGLE_REDIRECT_URL.
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_REDIRECT_URL=https://api.nichehive.org/api/v1/auth/google/callback

# ---------- Sessions ----------
# 32+ bytes of random. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
